# ==============================================================================
# BlinkEngine — Environment Configuration Template
# NASA Space Apps Challenge 2026: Field Shift
# Copy this file to .env and configure your keys
# ==============================================================================

# Server Environment (development / production)
ENV=development
PORT=8000
HOST=0.0.0.0

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,https://blinkfarms.vercel.app
# Optional: Set ENGINE_API_KEY to protect sensitive mutating endpoints (e.g. /field-memory/register)
# Leave empty in development to allow unauthenticated requests
ENGINE_API_KEY=

# NASA Earth Science APIs
# NASA POWER Open API: defaults to DEMO_KEY if not specified
NASA_API_KEY=DEMO_KEY
# NASA Earthdata Login Bearer Token (for CMR / SMAP / ECOSTRESS direct granules)
EARTHDATA_BEARER_TOKEN=

# Persistent Storage (Optional: defaults to local persistent JSON cache if not configured)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
